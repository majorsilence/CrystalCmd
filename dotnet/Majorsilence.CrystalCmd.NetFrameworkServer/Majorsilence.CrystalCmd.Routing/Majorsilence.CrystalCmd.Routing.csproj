<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Description>Decides which rendering backend a CrystalCmd request goes to: the caller's choice, the server's default, or, for Auto, a parse of the template against the serviceable rule. Needs only the Majorsilence.Crystal parser, not its engine.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.CrystalCmd.Common\Majorsilence.CrystalCmd.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Majorsilence.Crystal.Parser" />
  </ItemGroup>

</Project>
