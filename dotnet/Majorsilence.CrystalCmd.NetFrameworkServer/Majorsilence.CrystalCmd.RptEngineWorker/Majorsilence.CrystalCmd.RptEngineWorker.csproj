<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>Majorsilence.CrystalCmd.RptEngineWorker</AssemblyName>
    <Description>A CrystalCmd queue worker that renders with Majorsilence.Crystal instead of the SAP Crystal Reports runtime. Runs anywhere .NET 10 does; no Wine, no SAP install.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Majorsilence.CrystalCmd.RptEngine\Majorsilence.CrystalCmd.RptEngine.csproj" />
    <ProjectReference Include="..\Majorsilence.CrystalCmd.WorkQueues\Majorsilence.CrystalCmd.WorkQueues.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The sample the health check renders every minute; the same file the Crystal worker uses. -->
    <None Include="..\Majorsilence.CrystalCmd.Tests\thereport.rpt" Link="thereport.rpt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
